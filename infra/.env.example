# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=antispam
POSTGRES_USER=antispam
POSTGRES_PASSWORD=changeme_dev

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── FastAPI ────────────────────────────────────────────────────────────────────
SECRET_KEY=super_secret_jwt_key_change_in_production_64chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Spam report threshold (N reports promotes a number to confirmed spam)
SPAM_REPORT_THRESHOLD=5

# ── Go Sync Service ────────────────────────────────────────────────────────────
GO_SYNC_PORT=8080

# Bloom filter config (capacity, false-positive rate)
BLOOM_CAPACITY=10000000
BLOOM_ERROR_RATE=0.001

# ── Nginx ──────────────────────────────────────────────────────────────────────
NGINX_PORT=80

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
